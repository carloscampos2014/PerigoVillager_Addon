{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "calca14:fire_bow",
      "materials": {
        "default": "bow",
        "enchanted": "bow_enchanted"
      },
      "textures": {
        "default": "textures/items/fire_bow",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.bow"
      },
      "animations": {
        "hold": "animation.bow.hold",
        "bow_and_arrow": "animation.bow.bow_and_arrow"
      },
      "scripts": {
        "animate": [
          "hold",
          {
            "bow_and_arrow": "context.is_using_item == 1.0 && context.main_hand_item_use_duration > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
